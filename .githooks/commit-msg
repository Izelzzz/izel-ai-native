#!/usr/bin/env bash
# Reject commit messages that don't follow <type>(<scope>): <summary>.
set -euo pipefail

msg_file="$1"
subject="$(grep -v '^#' "$msg_file" | grep -m1 -v '^[[:space:]]*$' || true)"

# Git writes these subjects itself (merge, revert, rebase --autosquash), so they can't follow our format.
case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

exec "$(git rev-parse --show-toplevel)/scripts/validate-commit-msg.sh" "$msg_file"
